; Inno Setup script for whatSnap: a template that build.rs fills in as
; target\release\whatSnap.iss, beside the files it installs. `cargo release`
; compiles it; the @NAME@ values come from shipfitter's configure_file.

#define AppName "whatSnap"
#define AppExe "whatSnap.exe"
#define AppPublisher "Aryan Choudhary"
#define AppURL "https://github.com/aryanchoudharypro/whatSnap"
#define AppVersion "@PROJECT_VERSION@"
#define Root "@ROOT@"

[Setup]
AppId={{63FD6445-3903-4812-AF2B-1A9B0672C679}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}/issues
AppUpdatesURL={#AppURL}/releases

; Per-user install: no UAC prompt, works on machines where the user is not an
; administrator. {autopf} resolves to {localappdata}\Programs here.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes

ArchitecturesAllowed=@ARCH_ALLOWED@
ArchitecturesInstallIn64BitMode=@ARCH_MODE@

OutputDir=.
OutputBaseFilename={#AppName}_setup
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
SetupIconFile={#Root}\assets\icon.ico
WizardSmallImageFile={#Root}\assets\wizard-small.bmp

LicenseFile={#Root}\LICENSE
UninstallDisplayName={#AppName}
UninstallDisplayIcon={app}\{#AppExe}

; Offer to close a running instance rather than failing or silently leaving a
; stale exe in place, and start it again afterwards (whatSnap registers itself
; for that with RegisterApplicationRestart). "force" ends whatever hasn't
; closed by the Restart Manager's timeout, so a stuck backend can't block the
; update.
CloseApplications=force
RestartApplications=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked
; Windows only lists signed packaged apps in its Share menu. Turning this on
; signs whatSnap's small share package with a certificate made on this PC and
; trusts it, which needs an administrator's OK once (see share-target/).
Name: "sharemenu"; Description: "Show whatSnap in the Windows Share menu (an administrator has to approve this once)"; Flags: unchecked

[Files]
Source: "{#AppExe}"; DestDir: "{app}"; Flags: ignoreversion
Source: "backend\backend.exe"; DestDir: "{app}\backend"; Flags: ignoreversion
Source: "whatSnapShare.exe"; DestDir: "{app}"; Flags: ignoreversion
; Unsigned; the signed copy whatSnapShare.exe makes goes in {app}\share\local,
; which the installer never writes, so updates keep it.
Source: "share\whatSnapShare.msix"; DestDir: "{app}\share"; Flags: ignoreversion
Source: "{#Root}\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#Root}\backend\LICENSE"; DestDir: "{app}\backend"; Flags: ignoreversion
Source: "{#Root}\THIRD-PARTY-NOTICES.md"; DestDir: "{app}"; Flags: ignoreversion
Source: "readme.html"; DestDir: "{app}"; Flags: ignoreversion

[Icons]
; In the Programs folder itself (not a subfolder): notifications are tied to this
; shortcut, and the app looks for it at {userprograms}\whatSnap.lnk.
Name: "{userprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon
; Explorer's Send to menu: right-click files (or Shift+F10), Send to, whatSnap.
; Explorer starts the app with the files' paths, and it asks which chats to
; send them to.
Name: "{usersendto}\{#AppName}"; Filename: "{app}\{#AppExe}"

[Run]
; runasoriginaluser: start the app as the user who ran the installer, even if the
; installer was elevated. An elevated instance can't be reached by the normal
; Start menu and desktop launches, which then silently do nothing.
; The Share menu: turned on when ticked (see CurStepChanged, which says how it
; went), and otherwise kept up to date if an earlier install turned it on (a
; no-op if it didn't).
Filename: "{app}\whatSnapShare.exe"; Parameters: "--refresh"; Check: ShouldRefreshShareMenu; Flags: waituntilterminated runasoriginaluser
Filename: "{app}\{#AppExe}"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent runasoriginaluser

[UninstallRun]
Filename: "{app}\whatSnapShare.exe"; Parameters: "--disable"; Flags: runhidden waituntilterminated; RunOnceId: "RemoveShareMenu"

[UninstallDelete]
Type: filesandordirs; Name: "{app}\share\local"
Type: files; Name: "{app}\share\share.log"
Type: files; Name: "{app}\share\sign-error.txt"
Type: files; Name: "{app}\share\enable-result.txt"

[Code]
// EnableShareMenu handles the ticked case in an interactive install.
function ShouldRefreshShareMenu: Boolean;
begin
  Result := WizardSilent or not WizardIsTaskSelected('sharemenu');
end;

// Turns the Share menu on when its task is ticked. whatSnapShare.exe asks for
// administrator permission and writes how it went to a file; the result is
// shown here, in the installer's own window, so it gets focus and a screen
// reader reads it (a box from the helper could open behind the installer).
procedure EnableShareMenu;
var
  Helper: String;
  ResultFile: String;
  ResultCode: Integer;
  Text: AnsiString;
begin
  Helper := ExpandConstant('{app}\whatSnapShare.exe');
  ResultFile := ExpandConstant('{app}\share\enable-result.txt');
  DeleteFile(ResultFile);
  if not ExecAsOriginalUser(Helper, '--enable --quiet', '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
    ResultCode := -1;
  if not LoadStringFromFile(ResultFile, Text) then
    Text := 'whatSnap couldn''t be added to the Share menu. You can try again from whatSnap''s Settings.';
  if ResultCode = 0 then
    MsgBox(String(Text), mbInformation, MB_OK)
  else
    MsgBox(String(Text), mbError, MB_OK);
end;

// After installing: the Share menu (above), and Start-with-Windows, a per-user
// Run entry named whaNTV. Older versions point it at whantv.exe, which this
// install no longer provides, so re-point an existing entry at the new exe.
procedure CurStepChanged(CurStep: TSetupStep);
var
  RunPath: String;
  RunValue: String;
begin
  if (CurStep = ssPostInstall) and WizardIsTaskSelected('sharemenu') and not WizardSilent then
    EnableShareMenu;
  RunPath := 'Software\Microsoft\Windows\CurrentVersion\Run';
  if (CurStep = ssPostInstall) and RegQueryStringValue(HKCU, RunPath, 'whaNTV', RunValue) then
    RegWriteStringValue(HKCU, RunPath, 'whaNTV', '"' + ExpandConstant('{app}\{#AppExe}') + '" --background');
end;

// Own names: Inno already defines the FILE_ATTRIBUTE_* constants, and
// redefining one is a compile error.
const
  ATTR_DIRECTORY = $10;
  ATTR_REPARSE_POINT = $400;
  ATTR_INVALID = $FFFFFFFF;

function GetFileAttributes(lpFileName: String): Cardinal;
  external 'GetFileAttributesW@kernel32.dll stdcall';

// Whether Path is missing or is a symbolic link / junction. Links are never
// followed or deleted: one could lead anywhere, such as the user's Downloads.
function IsLinkOrMissing(Path: String): Boolean;
var
  Attr: Cardinal;
begin
  Attr := GetFileAttributes(Path);
  Result := (Attr = ATTR_INVALID) or ((Attr and ATTR_REPARSE_POINT) <> 0);
end;

// Deletes a folder that whatSnap itself creates, and what's in it, without
// following or removing any link inside it.
procedure DeleteOwnFolder(Dir: String);
var
  FindRec: TFindRec;
  Path: String;
begin
  if IsLinkOrMissing(Dir) then
    Exit;
  if FindFirst(Dir + '\*', FindRec) then
  begin
    try
      repeat
        if (FindRec.Name <> '.') and (FindRec.Name <> '..')
          and ((FindRec.Attributes and ATTR_REPARSE_POINT) = 0) then
        begin
          Path := Dir + '\' + FindRec.Name;
          if (FindRec.Attributes and ATTR_DIRECTORY) <> 0 then
            DeleteOwnFolder(Path)
          else
            DeleteFile(Path);
        end;
      until not FindNext(FindRec);
    finally
      FindClose(FindRec);
    end;
  end;
  RemoveDir(Dir);
end;

procedure DeleteOwnFile(Path: String);
begin
  if not IsLinkOrMissing(Path) then
    DeleteFile(Path);
end;

// User data lives in {localappdata}\whatSnap, outside {app}, so it survives
// uninstall unless the user asks otherwise. Removing it means re-pairing the
// phone and losing local history, so it is never the default.
//
// Only the files and folders whatSnap creates there are removed (see
// src/platform/paths.rs and backend/paths.go), never the whole folder blindly: anything
// else a user put in it, and anything a link points at, is left alone.
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  DataDir: String;
begin
  if CurUninstallStep = usPostUninstall then
  begin
    DataDir := ExpandConstant('{localappdata}\whatSnap');
    if DirExists(DataDir) and not IsLinkOrMissing(DataDir) then
    begin
      if SuppressibleMsgBox(
           'Also delete your whatSnap data?' #13#10 #13#10
           + 'This removes the WhatsApp session, local message history and '
           + 'media cached by the app in:' #13#10 + DataDir + #13#10 #13#10
           + 'Files you saved elsewhere with Save as are not touched. '
           + 'You would need to link your phone again. Choose No to keep it.',
           mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES then
      begin
        DeleteOwnFile(DataDir + '\session.db');
        DeleteOwnFile(DataDir + '\session.db-wal');
        DeleteOwnFile(DataDir + '\session.db-shm');
        DeleteOwnFile(DataDir + '\session.db-journal');
        DeleteOwnFile(DataDir + '\settings.json');
        DeleteOwnFile(DataDir + '\.migrated-from-whaNTV');
        DeleteOwnFolder(DataDir + '\logs');
        DeleteOwnFolder(DataDir + '\media_cache');
        // Only succeeds if nothing else is left in it.
        RemoveDir(DataDir);
      end;
    end;
  end;
end;
